# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional
VBIT_MODEL=gemini-2.5-flash
# Web search fallback (https://tavily.com)
TAVILY_API_KEY=your-tavily-key
# LangSmith tracing (https://smith.langchain.com); omit to disable
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=VBIT-Agent
# Comma separated origins allowed when the frontend is hosted separately
CORS_ORIGINS=http://localhost:5173
